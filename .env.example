# Public application URL
NEXT_PUBLIC_SITE_URL=https://www.galacticomnivore.com

# Resend (server-only)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM_TRANSACTIONAL=Galactic Omnivore <account@mail.galacticomnivore.com>
EMAIL_FROM_MARKETING=Galactic Omnivore Newsletter <newsletter@mail.galacticomnivore.com>
EMAIL_REPLY_TO=business@galacticomnivore.com
EMAIL_MARKETING_ADDRESS=
ADMIN_NOTIFICATION_EMAILS=

# Outbox, consent, and environment safety (server-only)
NEWSLETTER_TOKEN_SECRET=
NEWSLETTER_ENABLED=false
NEXT_PUBLIC_NEWSLETTER_ENABLED=false
CRON_SECRET=
EMAIL_DISABLE_SEND=true
EMAIL_PRODUCTION_DELIVERY=false
EMAIL_TEST_RECIPIENT=
EMAIL_TRACK_ENGAGEMENT=false
EMAIL_FAILURE_SPIKE_THRESHOLD=5

# Optional Resend Contacts configuration
RESEND_NEWSLETTER_TOPIC_ID=
RESEND_PACKAGE_TOPIC_ID=
RESEND_PROMOTIONS_TOPIC_ID=
RESEND_NEWSLETTER_SEGMENT_ID=

# Firebase client configuration (values are project identifiers, not admin keys)
