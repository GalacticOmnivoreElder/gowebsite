{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "es2022",
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": [
    "src/lib/content-visibility.js",
    "src/lib/content-entitlements.js",
    "src/lib/product-config.js",
    "src/lib/product-settings.js",
    "src/lib/product-notifications.js",
    "src/lib/learning-items.js",
    "src/lib/learning-enrollment.js",
    "src/lib/video-bundles.js",
    "src/lib/mentor-profiles.js",
    "src/lib/mentor-directory.js",
    "src/lib/training-assignments.js",
    "src/lib/mentorship.js",
    "src/lib/mentorship-service.js",
    "src/lib/mentorship-feedback.js",
    "src/lib/mentorship-feedback-service.js",
    "src/lib/asset-packs.js",
    "src/app/api/mentor-application/open/route.js",
    "src/app/api/admin/product-settings/route.js",
    "src/app/api/admin/learning-items/route.js",
    "src/app/api/admin/video-bundles/route.js",
    "src/app/api/admin/training-assignments/route.js",
    "src/app/api/admin/mentorships/route.js",
    "src/app/api/admin/asset-packs/route.js",
    "src/app/api/admin/resources-review/route.js",
    "src/app/api/learning-items/route.js",
    "src/app/api/learning-items/[slug]/route.js",
    "src/app/api/learning-items/[slug]/enrollment/route.js",
    "src/app/api/learning-items/[slug]/participants/route.js",
    "src/app/api/me/learning/route.js",
    "src/app/api/me/mentor-profile/route.js",
    "src/app/api/me/mentor-availability/route.js",
    "src/app/api/mentors/route.js",
    "src/app/api/mentors/[mentorId]/route.js",
    "src/app/api/mentorship/suggestions/route.js",
    "src/app/api/mentorship/requests/route.js",
    "src/app/api/mentorship/requests/[requestId]/response/route.js",
    "src/app/api/mentorship/requests/[requestId]/clarification/route.js",
