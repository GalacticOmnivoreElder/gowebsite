    "src/app/api/asset-packs/route.js",
    "src/app/asset-packs/[packId]/open/route.js",
    "src/app/api/notifications/route.js",
    "src/app/api/video-bundles/route.js",
    "src/app/api/video-bundles/[slug]/route.js",
    "src/app/api/video-bundles/[slug]/progress/route.js",
    "src/app/resources/[resourceId]/open/route.js",
    "src/app/video-bundles/[slug]/open/route.js"
